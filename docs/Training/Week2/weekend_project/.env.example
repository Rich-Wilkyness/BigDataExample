# run_pipeline.sh copies this example to the ignored .env file on the first run. Docker Compose
# substitutes these values into docker-compose.yml; they are runtime configuration, not image data.
POSTGRES_USER=pipeline
POSTGRES_PASSWORD=pipeline-password
POSTGRES_DB=sales
# This is the port exposed on the host. Containers still connect to postgres:5432 internally.
POSTGRES_PORT=5432
