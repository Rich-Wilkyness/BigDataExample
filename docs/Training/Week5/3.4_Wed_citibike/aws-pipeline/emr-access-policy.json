{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListOwnBucket",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket",
        "s3:GetBucketLocation"
      ],
      "Resource": "arn:aws:s3:::richard-wilkerson-citibike-pipeline-866934333672-us-east-2-an"
    },
    {
      "Sid": "ReadOwnInputs",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject"
      ],
      "Resource": [
        "arn:aws:s3:::richard-wilkerson-citibike-pipeline-866934333672-us-east-2-an/bronze/citibike/*",
        "arn:aws:s3:::richard-wilkerson-citibike-pipeline-866934333672-us-east-2-an/scripts/*"
      ]
    },
    {
      "Sid": "PublishOwnSilverAndLogs",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject"
      ],
      "Resource": [
        "arn:aws:s3:::richard-wilkerson-citibike-pipeline-866934333672-us-east-2-an/silver/citibike/*",
        "arn:aws:s3:::richard-wilkerson-citibike-pipeline-866934333672-us-east-2-an/logs/emr/*"
      ]
    },
    {
      "Sid": "ReadSparkCatalogMetadata",
      "Effect": "Allow",
      "Action": [
        "glue:GetDatabase",
        "glue:GetDatabases",
        "glue:GetTable",
        "glue:GetTables",
        "glue:GetPartition",
        "glue:GetPartitions",
        "glue:GetUserDefinedFunctions"
      ],
      "Resource": [
        "arn:aws:glue:us-east-2:866934333672:catalog",
        "arn:aws:glue:us-east-2:866934333672:database/default",
        "arn:aws:glue:us-east-2:866934333672:table/default/*"
      ]
    }
  ]
}
