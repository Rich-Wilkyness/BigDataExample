#!/bin/bash
set -euxo pipefail
dnf install -y python3 python3-pip
mkdir -p /opt/citibike-dashboard
printf '%s' '${app_base64}' | base64 -d > /opt/citibike-dashboard/app.py
printf '%s' '${requirements_base64}' | base64 -d > /opt/citibike-dashboard/requirements.txt
python3 -m venv /opt/citibike-dashboard/.venv
/opt/citibike-dashboard/.venv/bin/pip install --upgrade pip
/opt/citibike-dashboard/.venv/bin/pip install -r /opt/citibike-dashboard/requirements.txt
cat > /etc/systemd/system/citibike-dashboard.service <<'EOF'
[Unit]
Description=Citi Bike Streamlit Dashboard
After=network-online.target
Wants=network-online.target
[Service]
Type=simple
User=ec2-user
WorkingDirectory=/opt/citibike-dashboard
Environment=AWS_REGION=us-east-2
Environment=REDSHIFT_WORKGROUP=citibike-wg
Environment=REDSHIFT_DATABASE=dev
ExecStart=/opt/citibike-dashboard/.venv/bin/streamlit run app.py --server.address 0.0.0.0 --server.port 8501 --server.headless true --browser.gatherUsageStats false
Restart=always
RestartSec=5
[Install]
WantedBy=multi-user.target
EOF
chown -R ec2-user:ec2-user /opt/citibike-dashboard
systemctl daemon-reload
systemctl enable --now citibike-dashboard
